# Copy this file to .env and fill in real values.
# NOTE: .env is gitignored — NEVER commit real secrets.

# Neon PostgreSQL connection string (Render pe bhi yahi value set karo).
DATABASE_URL="postgresql://user:password@host.region.neon.tech/dbname?sslmode=require"

# Port the Express server will listen on.
# Render apna PORT khud inject karta hai — local dev ke liye 5000 theek hai.
PORT=5000

# The frontend URL used for CORS (Vercel). Comma-separated supported.
# Production: https://filesharing-frontend.vercel.app
# Local dev:  http://localhost:5173
FRONTEND_URL="http://localhost:5173"

# Cloudinary credentials (Render dashboard pe set karo — .env mein bharein).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
