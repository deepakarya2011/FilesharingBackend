# Copy this file to .env and fill in real values.
# NOTE: .env is gitignored — NEVER commit real secrets.

# MongoDB connection string (MongoDB Atlas se copy karo).
# Atlas me: Database -> Connect -> Drivers -> "mongodb+srv://..." wali string.
# Pehle yerha apna URI test karo isliye database name code se "filesharing" force hota hai,
# isliye URI mein /dbname hona zaroori nahi, lekin host + username + password zaroori hai.
# Correct form:
#   mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/?appName=Cluster0
# Database name: "filesharing"  (code mein set)
# Collections:   "shares" aur "files"  (models mein set)
MONGODB_URI="mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/?appName=Cluster0"

# (Optional) Database name override — default "filesharing".
# MONGODB_DB_NAME=filesharing

# Port the Express server will listen on.
PORT=5000

# The frontend URL used for CORS (Vercel). Comma-separated supported.
# Production: https://filesharing-frontend.vercel.app
# Local dev:  http://localhost:5173
FRONTEND_URL="http://localhost:5173"

# Cloudinary credentials (Render dashboard pe set karo — .env mein bharein).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
